{
  "name": "instagram-advisor",
  "version": "0.1.0",
  "description": "Instagram content advisor for @sebas_tcotd — powered by Claude",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
