    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "25.9.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "10.4.0",
    "eslint-plugin-boundaries": "6.0.2",
    "jiti": "^2.7.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
